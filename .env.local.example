# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; this template is safe to commit (no real secrets).
#
# In Amplify Hosting, set these as environment variables instead. Leave the
# DYNAMO_ACCESS_KEY_ID / DYNAMO_SECRET_ACCESS_KEY pair UNSET in Amplify so the
# SDK falls back to the compute role's IAM credentials.

DYNAMO_REGION=
DYNAMO_GAMES_TABLE_NAME=

# Local-only credentials (both must be set, or neither). Leave unset in Amplify.
DYNAMO_ACCESS_KEY_ID=
DYNAMO_SECRET_ACCESS_KEY=

# Optional: enables the "Start with AI rosters" button (web search + Claude).
# When unset, that button falls back to creating an empty scorecard.
#
# Locally the research runs inline in the Next dev server. In production the
# work is offloaded to the research-lineups Lambda (see lambdas/README.md), so
# ANTHROPIC_API_KEY must also be set ON THE LAMBDA, not just here.
ANTHROPIC_API_KEY=

# Roster autofill offloading. In production (NODE_ENV=production) the app always
# invokes the Lambda. Set USE_LAMBDA=1 to force the Lambda path locally too;
# leave unset to run the research inline in the dev server.
USE_LAMBDA=
# Name of the deployed Lambda (defaults to baseball-scorecard-research-lineups).
RESEARCH_LINEUPS_FUNCTION_NAME=
